
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# @playwright/cli browser artifacts (auto-saved snapshots) — the tester drops these
.playwright-cli/

# Eval harness runtime artifacts (manifest.json / result.json per run)
eval/runs/*
!eval/runs/.gitkeep

# beads (bd >= 1.3.0) cooperative lock files, e.g. .beads.gate.lock beside .beads/
*.gate.lock*
