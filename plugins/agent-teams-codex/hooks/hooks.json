{
  "description": "Tie Codex threads to initiatives, surface durable agent-teams mail, and gate role sessions until their learnings load.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/ensure-ateam-link.sh\"",
            "timeout": 5,
            "statusMessage": "Ensuring the agent-teams CLI is available"
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/ateam\" codex-hook session-start",
            "timeout": 15,
            "statusMessage": "Checking agent-teams session and mail",
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/ateam\" codex-hook pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/ateam\" codex-hook post-compact",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/ateam\" codex-hook session-end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
